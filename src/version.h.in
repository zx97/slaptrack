// version.h — generated by Make from CMakeLists.txt
//  @SLAPTRACK_VERSION@  → e.g. 1.4.0
//  @SLAPTRACK_BUILD@     → git commit count

#ifndef SLAPTRACK_VERSION_H
#define SLAPTRACK_VERSION_H

#define SLAPTRACK_VERSION "@SLAPTRACK_VERSION@"
#define SLAPTRACK_BUILD   "@SLAPTRACK_BUILD@"

#endif // SLAPTRACK_VERSION_H
